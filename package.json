{
  "name": "widemark",
  "version": "1.2.0",
  "description": "Compact Chrome bookmark side panel extension for browsing, search, organization, styling, and local duplicate checks.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check:i18n": "node scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run typecheck:scripts && npm run typecheck:test && npm run check:i18n",
    "dev": "vite",
    "build": "vite build",
    "build:sync": "npm run build && ./scripts/sync-to-windows.sh",
    "package": "npm run check && npm test && npm run build && node scripts/package-extension.ts",
    "assets:store": "node scripts/generate-store-assets.ts",
    "test": "vitest run"
  },
  "author": "N2NS Lab (https://n2ns.com)",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-types": "^0.1.454",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
