{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["chrome-types"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "rootDir": "src",
    "outDir": "build/src",
    "sourceMap": false
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
